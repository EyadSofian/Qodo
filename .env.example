# ── Engosoft Workspace ────────────────────────────────────────────────
# Copy to .env.local for development, or set these as variables on Railway.

# Port the API/static server listens on. Railway sets this for you.
PORT=3000

# Signs the session cookie. Required in production; 32+ random characters.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Signs the short-lived SSO tokens the other Engosoft apps verify.
# Whatever you put here must also be set in those apps. See docs/SSO.md.
SSO_SECRET=

# ── Google sign-in (optional) ───────────────────────────────────────
# Web OAuth client id from Google Cloud Console. Qodo requests only identity
# (openid/email/profile); it never asks to read the employee's Gmail inbox.
GOOGLE_CLIENT_ID=

# PostgreSQL. Leave empty to store everything in ./data/workspace.json instead
# — fine locally, but on Railway a redeploy wipes the container's disk, so add
# a Postgres service and paste its URL here.
DATABASE_URL=

# ── HR Excel + Telegram sync (optional) ─────────────────────────────
# The HR dashboard always accepts an authenticated .xlsx upload. Set these
# values only when the payroll team should also upload the same workbook to a
# Telegram bot. The webhook URL is: POST /api/hr/telegram
HR_TELEGRAM_BOT_TOKEN=
# Secret configured in Telegram's setWebhook call (16+ random characters).
HR_TELEGRAM_WEBHOOK_SECRET=
# Comma-separated numeric Telegram chat ids allowed to update HR. Leave empty
# only in a private development bot; production should always restrict chats.
HR_TELEGRAM_CHAT_IDS=
# Tenant receiving bot uploads. The single-company default is `engosoft`.
HR_ORGANIZATION_ID=engosoft

# ── Qodo AI (optional) ────────────────────────────────────────────────
# Option A: OpenAI. Without either this key or QODO_AI_BASE_URL, Qodo works
# normally and only the assistant features are disabled.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Option B: the trained Qodo model behind an OpenAI-compatible server.
# Local MLX example: http://127.0.0.1:8080/v1
QODO_AI_BASE_URL=
QODO_AI_API_KEY=
QODO_AI_MODEL=qodo-ai-qwen3-1.7b
# Optional separate model for Mail summaries/replies/action extraction.
MAIL_AI_MODEL=

# ── Phone notifications (optional) ────────────────────────────────────
# Web push needs a VAPID key pair. Generate one with:
#   npx web-push generate-vapid-keys
# Without them the workspace still shows in-app notifications; only the
# push-to-phone part is off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address for push services — must be a mailto: or https: URL.
VAPID_SUBJECT=mailto:admin@engosoft.com

# ── Scheduled notifications (need the VAPID keys above) ───────────────
# Daily digest: how many open tasks each department is carrying. Managers
# get the full breakdown; everyone else gets their own workload.
DIGEST_HOUR=9
# The server runs in UTC on Railway, so the digest needs a real timezone or
# it fires in the middle of the night.
DIGEST_TIMEZONE=Africa/Cairo
# How often to check whether the Insights Hub published a new sync. It
# refreshes a few times a day, so polling faster just wastes requests.
INSIGHTS_POLL_MINUTES=30

# ── First administrator ───────────────────────────────────────────────
# Created once on first boot only. Leave ADMIN_PASSWORD empty and the server
# prints a generated one to the logs.
ADMIN_EMAIL=admin@engosoft.com
ADMIN_NAME=مدير النظام
ADMIN_PASSWORD=

# Set to `production` when deploying — it enables secure cookies and turns the
# missing-secret warnings into hard errors.
NODE_ENV=development

# ── Odoo training catalogue (optional) ───────────────────────────────
# Read-only connection used by الإيفينتات and الكورسات.
ODOO_URL=https://engosoft.com
ODOO_DB=EngoSoft
ODOO_LOGIN=
ODOO_API_KEY=
# Optional; skips the first authentication round trip.
ODOO_UID=
# Private n8n production webhook used only when a manager clicks "live sync".
# Keep the URL in Railway variables; it must never be sent to the browser.
# The Insights Hub, for the price advisor module. The secret authenticates this
# *process* to the hub (matching INTERNAL_API_SECRET there); it never reaches a
# browser, and unset means the module reports itself as not configured rather
# than showing an empty price.
INSIGHTS_HUB_URL=
INSIGHTS_INTERNAL_SECRET=

INSIGHTS_N8N_REFRESH_URL=
# Comma-separated product.template ids that are free even if Odoo says the
# channel uses payment enrolment. The Engosoft default is Freelance Masterclass.
ODOO_FREE_COURSE_TEMPLATE_IDS=2056
