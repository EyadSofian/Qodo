# ── Engosoft Workspace ────────────────────────────────────────────────
# Copy to .env.local for development, or set these as variables on Railway.

# Port the API/static server listens on. Railway sets this for you.
PORT=3000

# Signs the session cookie. Required in production; 32+ random characters.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Signs the short-lived SSO tokens the other Engosoft apps verify.
# Whatever you put here must also be set in those apps. See docs/SSO.md.
SSO_SECRET=

# PostgreSQL. Leave empty to store everything in ./data/workspace.json instead
# — fine locally, but on Railway a redeploy wipes the container's disk, so add
# a Postgres service and paste its URL here.
DATABASE_URL=

# ── Assistant (optional) ──────────────────────────────────────────────
# Without a key the workspace runs normally and the assistant panel reports
# that it isn't configured. Key from https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Model id. Change this rather than the code when OpenAI renames or retires a
# model. gpt-4o-mini is the cheap default; any chat model with function calling
# works. See docs/ASSISTANT.md.
OPENAI_MODEL=gpt-4o-mini

# ── Phone notifications (optional) ────────────────────────────────────
# Web push needs a VAPID key pair. Generate one with:
#   npx web-push generate-vapid-keys
# Without them the workspace still shows in-app notifications; only the
# push-to-phone part is off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address for push services — must be a mailto: or https: URL.
VAPID_SUBJECT=mailto:admin@engosoft.com

# ── Scheduled notifications (need the VAPID keys above) ───────────────
# Daily digest: how many open tasks each department is carrying. Managers
# get the full breakdown; everyone else gets their own workload.
DIGEST_HOUR=9
# The server runs in UTC on Railway, so the digest needs a real timezone or
# it fires in the middle of the night.
DIGEST_TIMEZONE=Africa/Cairo
# How often to check whether the Insights Hub published a new sync. It
# refreshes a few times a day, so polling faster just wastes requests.
INSIGHTS_POLL_MINUTES=30

# ── First administrator ───────────────────────────────────────────────
# Created once on first boot only. Leave ADMIN_PASSWORD empty and the server
# prints a generated one to the logs.
ADMIN_EMAIL=admin@engosoft.com
ADMIN_NAME=مدير النظام
ADMIN_PASSWORD=

# Set to `production` when deploying — it enables secure cookies and turns the
# missing-secret warnings into hard errors.
NODE_ENV=development

# ── Odoo training catalogue (optional) ───────────────────────────────
# Read-only connection used by الإيفينتات and الكورسات.
ODOO_URL=https://engosoft.com
ODOO_DB=EngoSoft
ODOO_LOGIN=
ODOO_API_KEY=
# Optional; skips the first authentication round trip.
ODOO_UID=
# Comma-separated product.template ids that are free even if Odoo says the
# channel uses payment enrolment. The Engosoft default is Freelance Masterclass.
ODOO_FREE_COURSE_TEMPLATE_IDS=2056
